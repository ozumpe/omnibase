{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEC2ForTofuAndTheDriver",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "LaunchOnlyTheTaggedRunBox",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": "arn:aws:ec2:us-east-1:696644743351:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Name": "sis-first-run",
          "aws:RequestTag/sis:created-by": "scheduled-run"
        }
      }
    },
    {
      "Sid": "LaunchFromCanonicalUbuntuOnly",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": "arn:aws:ec2:us-east-1::image/*",
      "Condition": {"StringEquals": {"ec2:Owner": ["099720109477", "amazon"]}}
    },
    {
      "Sid": "LaunchIntoTheEgressOnlyGroup",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": "arn:aws:ec2:us-east-1:696644743351:security-group/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Name": "sis-first-run-egress-only"}}
    },
    {
      "Sid": "LaunchSideResources",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances"],
      "Resource": [
        "arn:aws:ec2:us-east-1:696644743351:subnet/*",
        "arn:aws:ec2:us-east-1:696644743351:network-interface/*",
        "arn:aws:ec2:us-east-1:696644743351:volume/*"
      ]
    },
    {
      "Sid": "TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags"],
      "Resource": [
        "arn:aws:ec2:us-east-1:696644743351:instance/*",
        "arn:aws:ec2:us-east-1:696644743351:volume/*"
      ],
      "Condition": {"StringEquals": {"ec2:CreateAction": "RunInstances"}}
    },
    {
      "Sid": "StartStopTerminateOnlyTheRunBox",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances"],
      "Resource": "arn:aws:ec2:us-east-1:696644743351:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Name": "sis-first-run"}}
    },
    {
      "Sid": "GiveTheBoxItsRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::696644743351:role/sis-first-run-instance",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "ReadTheBoxProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::696644743351:instance-profile/sis-first-run-instance"
    },
    {
      "Sid": "FindTheUbuntuAMI",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/*"
    },
    {
      "Sid": "RunShellOnlyOnTheRunBox",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:696644743351:instance/*",
      "Condition": {"StringEquals": {"ssm:resourceTag/Name": "sis-first-run"}}
    },
    {
      "Sid": "OnlyTheRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "ReadCommandResultsAndAgentState",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListRunArtifacts",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::sis-first-run-artifacts-696644743351"
    },
    {
      "Sid": "ReadRunArtifactObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::sis-first-run-artifacts-696644743351/*"
    },
    {
      "Sid": "WriteOnlyTheBoxStackStateAndLock",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::sis-first-run-artifacts-696644743351/tofu/*"
    }
  ]
}
